{
  "$schema": "http://json-schema.org/",
  "title": "IOA_to_Coach_Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_version",
    "user_id",
    "preferred_name",
    "primary_struggle",
    "desired_direction",
    "readiness_level",
    "time_availability",
    "coach_recommendation",
    "consent_acknowledged",
    "created_at"
  ],
  "properties": {
    "handoff_version": {
      "type": "string",
      "description": "Schema version for backward compatibility",
      "example": "1.0.0"
    },
    "user_id": {
      "type": "string",
      "description": "Stable internal user identifier"
    },
    "preferred_name": {
      "type": "string",
      "description": "Name the coach should use when addressing the user"
    },
    "primary_struggle": {
      "type": "string",
      "description": "User’s self-described core struggle, verbatim"
    },
    "desired_direction": {
      "type": "string",
      "description": "User’s expressed direction or orientation they want to move toward"
    },
    "readiness_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Self-reported readiness to engage in change"
    },
    "time_availability": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Rough estimate of time/energy available for coaching actions"
    },
    "coach_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coach_type", "confidence"],
      "properties": {
        "coach_type": {
          "type": "string",
          "description": "Identifier for the recommended coach specialization"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "IOA confidence score in coach selection"
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional non-diagnostic flags (e.g., 'low_motivation', 'overwhelm')"
    },
    "consent_acknowledged": {
      "type": "boolean",
      "description": "User acknowledged coaching boundaries and limitations"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when handoff payload was generated"
    }
  }
}